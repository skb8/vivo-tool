<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужно, чтобы показать название и иконку приложений, для которых есть твики -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="com.vivo.permission.GET_INSTALLED_APPS" />

    <application
        android:name=".VivoToolApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.VivoTool">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
